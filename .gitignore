# Proxmox API token / dashboard config — generated by bootstrap.sh on first run.
# Never commit this file; it holds the scoped API token, host, and node details.
proxmox.conf
config/proxmox.conf

# Editor/OS cruft
.DS_Store
*.swp

# scripts/.local/share and scripts/.local/state are stowed to ~/.local/share
# and ~/.local/state wholesale (Stow folds the whole dir when the target
# doesn't pre-exist) — every app's runtime cache/state/data lands here, not
# just dotfiles. Safety net until this gets unfolded properly; do not commit
# any of it.
scripts/.local/share/
scripts/.local/state/

# scripts/.local/lib is where `pip install --user` puts site-packages —
# same stow-folding issue as share/state above, just for Python installs.
# The entry-point shims pip drops in bin/ (agy, inv, invoke — from
# installing the `invoke` task runner and friends) are equally not
# hand-authored, so they're named individually rather than ignoring all
# of bin/, which does hold real hand-written scripts (create_vm.sh etc).
scripts/.local/lib/
scripts/.local/bin/agy
scripts/.local/bin/inv
scripts/.local/bin/invoke
scripts/.local/bin/markdown-it
scripts/.local/bin/pyfiglet
scripts/.local/bin/pygmentize
