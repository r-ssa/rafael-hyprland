;; Proxmox dashboard. Opened via SUPER+X (see hyprland.conf) or by clicking
;; the Waybar Proxmox module. Polls proxmox_stats.py, the same script the
;; Waybar module uses, every 5s.
;;
;; Phase 5 adds VM create/delete. Safety invariants, don't relax these:
;;  - create_vm.sh and delete_vm.sh each have their own explicit rofi
;;    confirmation step — nothing here bypasses that.
;;  - delete is only ever shown for guests with dashboard_managed = true
;;    (see proxmox_stats.py) — pre-existing guests like mineserver or
;;    hyprland-test never get a delete button, full stop.

(defpoll proxmox_stats
  :interval "5s"
  :initial "{\"status\": \"config_error\", \"message\": \"loading...\"}"
  "~/.local/bin/proxmox_stats.py")

(defwidget guest-row [guest]
  (box :class "guest-row" :orientation "h" :space-evenly false
    (label :class "guest-status ${guest.status}" :text "●")
    (label :class "guest-name" :text "${guest.name} (${guest.vmid})" :halign "start" :hexpand true)
    (label :class "guest-metric" :text "${guest.cpu_pct}% cpu")
    (label :class "guest-metric" :text "${guest.mem_pct}% mem")
    (button :class "delete-btn"
            :visible {guest.dashboard_managed}
            :onclick "~/.local/bin/delete_vm.sh ${guest.vmid} ${guest.name}"
      "🗑")))

(defwidget node-summary []
  (box :orientation "v" :space-evenly false :class "node-summary"
    (label :class "node-title" :text "Node")
    (box :orientation "h" :space-evenly true
      (label :text "CPU ${proxmox_stats.node.cpu_pct}%")
      (label :text "Mem ${proxmox_stats.node.mem_pct}%")
      (label :text "Disk ${proxmox_stats.node.disk_pct}%"))))

(defwidget error-view []
  (box :orientation "v" :class "error-view" :space-evenly false
    (label :class "error-icon" :text "⚠")
    (label :class "error-title" :text {proxmox_stats.status == "network_down" ? "Your network is down" :
                                        proxmox_stats.status == "timeout" ? "Proxmox is slow / not responding" :
                                        proxmox_stats.status == "unreachable" ? "Proxmox host unreachable" :
                                        proxmox_stats.status == "auth_error" ? "API token rejected" :
                                        proxmox_stats.status == "config_error" ? "Not configured yet" :
                                        "Something went wrong"})
    (label :class "error-detail" :text "${proxmox_stats.message}")))

(defwidget dashboard []
  (box :orientation "v" :class "dashboard" :space-evenly false
    (box :orientation "h" :space-evenly false
      (label :class "dashboard-title" :text "Proxmox" :hexpand true :halign "start")
      (button :class "new-vm-btn" :onclick "~/.local/bin/create_vm.sh" "+ New VM"))
    (box :orientation "v" :space-evenly false
      :visible {proxmox_stats.status == "ok"}
      (node-summary)
      (box :orientation "v" :class "guest-list" :space-evenly false
        (for guest in {proxmox_stats.guests ?: []}
          (guest-row :guest guest))))
    (box :visible {proxmox_stats.status != "ok"}
      (error-view))))

;; Every popup below closes on an outside click via a background listener
;; (see scripts/eww-outside-click-watcher.sh, exec-once'd in
;; hyprland.conf), not a GTK-side trick — a full-monitor invisible
;; "catcher" window was tried first, but its background never actually
;; composited as transparent (GTK's window/.background CSS node ignores a
;; plain `background-color: transparent` here), so it blacked out the
;; whole screen behind it instead of just catching clicks. The listener
;; watches Hyprland's event socket for focus moving to any other window
;; and closes whichever of these are open — same end result, no risk of
;; painting over your desktop.
(defwindow proxmox-dashboard
  :monitor 1
  :geometry (geometry :x "0%" :y "40px" :anchor "top right" :width "340px" :height "1px")
  :stacking "fg"
  :exclusive false
  (dashboard))

;; Volume slider popup — toggled by left-clicking waybar's pulseaudio
;; module (right-click still opens volume-menu.sh for output/input device
;; switching, that's a selection list, not a slider — different job).
(defpoll volume_info
  :interval "1s"
  :initial "{\"volume\": 0, \"muted\": false, \"desc\": \"\"}"
  "~/.config/eww/scripts/volume_info.sh")

(defwidget volume-slider []
  (box :orientation "v" :class "volume-popup" :space-evenly false
    (box :orientation "h" :space-evenly false
      (label :class "volume-icon" :text {volume_info.muted ? "󰖁" : volume_info.volume > 50 ? "󰕾" : volume_info.volume > 0 ? "󰕿" : "󰖀"})
      (label :class "volume-desc" :text "${volume_info.desc}" :hexpand true :halign "start" :limit-width 22)
      (label :class "volume-pct" :text "${volume_info.volume}%"))
    (scale :class "volume-scale"
           :value {volume_info.volume}
           :min 0
           :max 100
           :round-digits 0
           :onchange "pactl set-sink-volume @DEFAULT_SINK@ {}%")
    (button :class "mute-btn" :onclick "pactl set-sink-mute @DEFAULT_SINK@ toggle"
      (label :text {volume_info.muted ? "Unmute" : "Mute"}))))

(defwindow volume-popup
  :monitor 1
  :geometry (geometry :x "20px" :y "40px" :anchor "top right" :width "280px" :height "1px")
  :stacking "overlay"
  :exclusive false
  (volume-slider))

;; Power menu — toggled by SUPER+Q or clicking waybar's clock. Windows
;; 11-style: a tiny quick-toggle row (night light, settings) up top, then
;; just the three things an actual power menu needs — Logout, Restart,
;; Power off — each with an icon, not a wall of text options nobody uses
;; day to day. Lock and Relogin aren't gone, they're one right-click away
;; on Logout (mirrors how Windows tucks less-common actions behind a
;; secondary interaction instead of listing everything flat).
;;
;; Each action closes the menu before running so it doesn't linger on
;; screen through a lock/suspend/etc. Unlike wlogout, eww's daemon stays
;; running the whole session (exec-once'd in hyprland.conf) instead of
;; exiting right after a click, so idle-settings.sh's rofi prompts are
;; never at risk of getting killed mid-interaction the way they were
;; under wlogout.
(defvar logout_expanded false)
(defvar nightlight_active false)

(defwidget quick-icon-btn [icon action active]
  (button :class "quick-icon-btn ${active ? "active" : ""}" :onclick action
    (label :class "quick-icon" :text icon)))

(defwidget power-row [icon label action]
  (button :class "power-row" :onclick action
    (box :orientation "h" :space-evenly false :spacing 10
      (label :class "power-row-icon" :text icon)
      (label :class "power-row-label" :text label :halign "start" :hexpand true))))

(defwidget logout-row []
  (button :class "power-row"
          :onclick "eww close power-menu; hyprctl dispatch exit"
          :onrightclick "~/.config/hypr/scripts/toggle-eww-var.sh logout_expanded"
    (box :orientation "h" :space-evenly false :spacing 10
      (label :class "power-row-icon" :text "")
      (label :class "power-row-label" :text "Logout" :halign "start" :hexpand true)
      (label :class "power-row-hint" :text "right-click for more" :visible {!logout_expanded}))))

(defwidget power-menu []
  (box :orientation "v" :class "power-menu-card" :space-evenly false
    (box :orientation "h" :class "quick-row" :space-evenly true
      (quick-icon-btn :icon "" :action "~/.config/hypr/scripts/toggle-nightlight.sh" :active {nightlight_active})
      (quick-icon-btn :icon "" :action "eww close power-menu; ~/.config/hypr/scripts/idle-settings.sh" :active false))
    (box :class "power-menu-sep")
    (logout-row)
    (box :orientation "v" :class "logout-extra" :space-evenly false :visible {logout_expanded}
      (power-row :icon "" :label "Lock" :action "eww close power-menu; hyprlock")
      (power-row :icon "" :label "Relogin" :action "eww close power-menu; ~/.config/hypr/scripts/relogin.sh"))
    (power-row :icon "" :label "Restart" :action "eww close power-menu; systemctl reboot")
    (power-row :icon "" :label "Power off" :action "eww close power-menu; systemctl poweroff")))

(defwindow power-menu
  :monitor 1
  :geometry (geometry :x "0px" :y "0px" :anchor "center" :width "1px" :height "1px")
  :stacking "overlay"
  :exclusive false
  (power-menu))
