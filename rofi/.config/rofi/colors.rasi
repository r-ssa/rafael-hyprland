* {
    bg:     #0e1415;
    fg:     #dee3e5;
    accent: #ffffff;
    surface: #0e1415;
    /* Alpha EB == 235/255 == 0.92, exactly decoration:active_opacity from
       hyprland.conf, so a menu using this matches what the Claude Code
       scratchpad window gets from Hyprland automatically. Lets the
       `layerrule = ... blur on` blur show through (see hyprland.conf's
       "scratchpad look" block). NB: rofi's .rasi parser rejects
       underscores in property names — this must stay hyphenated. */
    bg-translucent: #0e1415EB;
}
