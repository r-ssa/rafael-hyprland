// Colors are regenerated by matugen into colors.rasi — see
// ~/.config/matugen/templates/rofi-colors.rasi. Don't hand-edit colors.rasi.
@import "colors.rasi"

configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Adwaita";
    font: "JetBrainsMono Nerd Font 12";
    display-drun: "Apps";
    display-run: "Run";
    display-window: "Windows";
}

window {
    width: 30%;
    border-radius: 12px;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
}

mainbox {
    padding: 12px;
}

inputbar {
    background-color: @surface;
    border-radius: 8px;
    padding: 8px 12px;
    children: [entry];
}

entry {
    text-color: @fg;
    placeholder: "Search...";
}

listview {
    margin: 8px 0 0 0;
    lines: 8;
    scrollbar: false;
}

element {
    padding: 6px 10px;
    border-radius: 6px;
    text-color: @fg;
}

element selected {
    background-color: @accent;
    text-color: @bg;
}
