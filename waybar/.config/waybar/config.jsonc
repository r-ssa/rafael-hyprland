{
    "output": ["DP-4"],
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 0,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": [
        "custom/proxmox",
        "cpu",
        "memory",
        "custom/gpu",
        "temperature",
        "pulseaudio"
    ],

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "active": "",
            "default": ""
        }
    },

    "hyprland/window": {
        "max-length": 50,
        "separate-outputs": true
    },

    "clock": {
        "format": "{:%H:%M   %a %d %b}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "eww open --toggle power-menu"
    },

    "cpu": {
        "format": "  CPU {usage}%",
        "interval": 5
    },

    "memory": {
        "format": "󰍛  RAM {used:0.1f}/{total:0.1f} GiB",
        "tooltip-format": "RAM: {percentage}% used ({used:0.1f} GiB of {total:0.1f} GiB)",
        "interval": 5
    },

    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu_usage.sh",
        "format": "󰻠 GPU {}%",
        "interval": 5,
        "tooltip": false
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["", "", ""]
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " muted",
        "format-icons": {
            "default": ["", ""]
        },
        "on-click": "eww open --toggle volume-popup",
        "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "~/.config/hypr/scripts/audio-devices-menu.sh",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
        "tooltip-format": "{desc}: {volume}%"
    },

    "custom/proxmox": {
        "exec": "~/.config/waybar/scripts/proxmox_waybar.sh",
        "on-click": "eww open --toggle proxmox-dashboard",
        "return-type": "json",
        "interval": 15,
        "tooltip": true
    }
}
